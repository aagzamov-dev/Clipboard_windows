<Window x:Class="Clipboard.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Clipboard Settings" Width="590" Height="650" MinWidth="500" MinHeight="460"
 WindowStartupLocation="CenterScreen" Icon="Assets/Clipboard.ico"
 Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" Closing="OnClosing">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Clipboard Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <TabControl Grid.Row="1" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
   <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
    <TextBlock Text="Open Clipboard" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBox x:Name="ShortcutInput" IsReadOnly="True" PreviewKeyDown="OnShortcutKeyDown" AutomationProperties.Name="Open Clipboard shortcut"/>
    <TextBlock Text="Click and press Ctrl or Alt with a letter, number, or function key. Windows+V stays available to Windows." TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,20"/>
    <TextBlock Text="Opens beside your mouse, on its monitor. The popup stays inside the working area, clear of the taskbar." TextWrapping="Wrap" Margin="0,0,0,18"/>
    <CheckBox x:Name="Animation" Content="Use a short opening animation" Margin="0,0,0,12"/>
    <CheckBox x:Name="LaunchAtLogin" Content="Launch at login" Margin="0,0,0,18"/>
    <TextBlock Text="Appearance" Margin="0,0,0,8"/>
    <ComboBox x:Name="Appearance" SelectedIndex="0"><ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/></ComboBox>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="History"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
    <CheckBox x:Name="StartMonitoring" Content="Record new copies when Clipboard starts" Margin="0,0,0,18"/>
    <TextBlock Text="Keep unpinned items for this many days (blank = forever)" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox x:Name="Retention" Margin="0,0,0,16"/>
    <TextBlock Text="Maximum unpinned items (blank = unlimited)" Margin="0,0,0,6"/><TextBox x:Name="MaximumCount" Margin="0,0,0,16"/>
    <CheckBox x:Name="WeeklyCleanup" Content="Run cleanup weekly rather than daily" Margin="0,0,0,12"/>
    <CheckBox x:Name="PinnedFirst" Content="Show pinned entries first" Margin="0,0,0,18"/>
    <TextBlock Text="Separator between combined text entries" Margin="0,0,0,6"/><TextBox x:Name="Separator" Height="60" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Text="Pinned entries and unsaved individual drafts are protected from automatic cleanup." TextWrapping="Wrap" Opacity="0.7" Margin="0,12"/>
    <WrapPanel><Button Content="Clear unpinned history…" Click="OnClearUnpinned"/><Button Content="Clear all…" Click="OnClearAll" Margin="8,0,0,0"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Privacy"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
    <TextBlock Text="All history stays on this PC. The database is not encrypted. Password-protected backup files are encrypted." TextWrapping="Wrap" Margin="0,0,0,18"/>
    <TextBlock Text="Exclude apps (one executable name per line, e.g. KeePass.exe)" TextWrapping="Wrap" Margin="0,0,0,6"/><TextBox x:Name="ExcludedApps" AcceptsReturn="True" Height="160" VerticalScrollBarVisibility="Auto"/>
    <TextBlock Text="Supported confidential clipboard markers are skipped. This cannot detect every password or secret. Pause recording before copying sensitive information. File history stores references; original files are never deleted." TextWrapping="Wrap" Opacity="0.7" Margin="0,16,0,16"/>
    <Button Content="Open local data folder" Click="OnOpenData" HorizontalAlignment="Left"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Backups"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
    <TextBlock Text="History backup" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Export a consistent snapshot of your history, including image contents and file references. Referenced files themselves are not included. Import merges history and leaves existing entries intact." TextWrapping="Wrap" Margin="0,0,0,16"/>
    <TextBlock Text="Backup password (optional for export, required for encrypted import)" TextWrapping="Wrap" Margin="0,0,0,6"/><PasswordBox x:Name="BackupPassword" Padding="8"/>
    <TextBlock Text="Use at least 8 characters. Without this password an encrypted backup cannot be recovered." TextWrapping="Wrap" Opacity="0.7" Margin="0,8,0,16"/>
    <WrapPanel><Button x:Name="ExportButton" Content="Export history…" Click="OnExport"/><Button x:Name="ImportButton" Content="Import history…" Click="OnImport" Margin="8,0,0,0"/></WrapPanel>
    <Separator Margin="0,24,0,16"/><TextBlock Text="Settings" FontWeight="SemiBold" Margin="0,0,0,12"/>
    <WrapPanel><Button Content="Export settings…" Click="OnExportSettings"/><Button Content="Import settings…" Click="OnImportSettings" Margin="8,0,0,0"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="About"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
    <TextBlock x:Name="VersionLabel" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <CheckBox x:Name="UpdateChecks" Content="Check for updates daily" Margin="0,0,0,12"/>
    <Button Content="Check for updates" Click="OnCheckUpdates" HorizontalAlignment="Left"/>
    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,12,0,20"/>
    <TextBlock Text="Automatic paste" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="Windows may block pasting into elevated apps or secure desktops. Clipboard never elevates itself or bypasses that restriction. Copy works independently; use Ctrl+V manually if needed." TextWrapping="Wrap" Margin="0,0,0,12"/>
    <Button Content="Show last paste status" Click="OnPasteStatus" HorizontalAlignment="Left"/>
    <TextBlock x:Name="PasteStatus" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Margin="0,14"/>
  <DockPanel Grid.Row="3"><Button DockPanel.Dock="Left" Content="Reset defaults" Click="OnReset"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="OnCancel" Margin="8,0"/><Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="OnSave"/></StackPanel></DockPanel>
 </Grid>
</Window>
