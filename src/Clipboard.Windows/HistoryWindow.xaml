<Window x:Class="Clipboard.Windows.HistoryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 xmlns:local="clr-namespace:Clipboard.Windows"
 Title="Clipboard" Width="440" Height="520" WindowStyle="None" ResizeMode="CanResize"
 MinWidth="340" MinHeight="380" ShowInTaskbar="False" Topmost="True"
 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
 Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
 Icon="Assets/Clipboard.ico" Deactivated="OnDeactivated" PreviewKeyDown="OnKeyDown" IsVisibleChanged="OnVisibilityChanged">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <DrawingBrush x:Key="ImageCanvas" TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#D7D7DC" Geometry="M0,0 H12 V12 H0 Z"/><GeometryDrawing Brush="#B9B9C2" Geometry="M0,0 H6 V6 H0 Z M6,6 H12 V12 H6 Z"/></DrawingGroup></DrawingBrush.Drawing></DrawingBrush>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="12" Background="{DynamicResource WindowTint}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Height="40" Margin="0,0,0,10" Background="Transparent" ToolTip="Drag this title area to move Clipboard">
    <Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButton}" Click="OnDismiss" ToolTip="Close  Esc" AutomationProperties.Name="Close clipboard" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button DockPanel.Dock="Right" Content="&#xE713;" Style="{StaticResource IconButton}" Click="OnSettings" ToolTip="Settings  Ctrl+," AutomationProperties.Name="Settings" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <ToggleButton x:Name="KeepOpenButton" DockPanel.Dock="Right" Content="Keep open" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="11" Width="76" Style="{StaticResource IconToggleButton}" Click="OnKeepOpen" ToolTip="Keep Clipboard open above other apps" AutomationProperties.Name="Keep Clipboard open above other apps" VerticalAlignment="Center" Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <Button x:Name="RecordingButton" DockPanel.Dock="Right" Content="Pause" Click="OnRecording" Margin="0,0,6,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="Clipboard" FontWeight="SemiBold" FontSize="18"/><TextBlock x:Name="RecordingStatus" FontSize="10" Foreground="{DynamicResource SecondaryInk}" Margin="0,2,0,0"/></StackPanel>
   </DockPanel>
   <Grid Grid.Row="1">
    <TextBox x:Name="Search" TextChanged="OnSearch" MaxLength="1024" Height="34" MinHeight="34" Padding="34,7,10,7" ToolTip="Search clipboard history  Ctrl+F" AutomationProperties.Name="Search clipboard history"/>
    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryInk}"/>
    <TextBlock Text="Search your history" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource SecondaryInk}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <StackPanel Grid.Row="2" Margin="0,8,0,4">
    <WrapPanel Orientation="Horizontal">
     <ComboBox x:Name="Types" Width="104" SelectedIndex="0" SelectionChanged="OnFilter" AutomationProperties.Name="Content type" Margin="0,0,8,6"><ComboBoxItem Content="All types"/><ComboBoxItem Content="Text"/><ComboBoxItem Content="Link"/><ComboBoxItem Content="Code"/><ComboBoxItem Content="Image"/><ComboBoxItem Content="Files"/></ComboBox>
     <ComboBox x:Name="Dates" Width="118" SelectedIndex="3" SelectionChanged="OnDateFilter" AutomationProperties.Name="Date range" Margin="0,0,8,6"><ComboBoxItem Content="Today"/><ComboBoxItem Content="Yesterday"/><ComboBoxItem Content="Last 7 days"/><ComboBoxItem Content="All history"/><ComboBoxItem x:Name="SelectedDay" Content="Selected day"/></ComboBox>
     <CheckBox x:Name="PinnedFilter" Content="Pinned" VerticalAlignment="Center" Margin="0,0,8,6" Click="OnFilter"/>
     <Button Content="&#xE76B;" Style="{StaticResource IconButton}" Click="OnPreviousDay" ToolTip="Previous day" AutomationProperties.Name="Previous day"/>
     <Button x:Name="NextDay" Content="&#xE76C;" Style="{StaticResource IconButton}" Click="OnNextDay" ToolTip="Next day" AutomationProperties.Name="Next day"/>
    </WrapPanel>
    <Button x:Name="RefreshButton" Content="New copies available · Refresh" Visibility="Collapsed" Click="OnRefresh" HorizontalAlignment="Stretch" Margin="0,4,0,0"/>
   </StackPanel>
   <DockPanel Grid.Row="3" Margin="0,0,0,6">
    <DockPanel.Style><Style TargetType="DockPanel"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Notice}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></DockPanel.Style>
    <Button x:Name="UndoButton" DockPanel.Dock="Right" Content="Undo delete" Visibility="Collapsed" Click="OnUndo"/>
    <TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="12" Opacity="0.8" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
   <Grid x:Name="ContentGrid" Grid.Row="4" SizeChanged="OnContentSizeChanged">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="HistoryColumn" Width="*"/><ColumnDefinition x:Name="PreviewColumn" Width="0"/></Grid.ColumnDefinitions>
    <Grid x:Name="HistoryPanel">
     <ListBox x:Name="HistoryList" SelectionMode="Extended" SelectionChanged="OnSelection" PreviewMouseLeftButtonUp="OnRowClick" PreviewTextInput="OnListTyping"
       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
       AutomationProperties.Name="Clipboard history" Background="Transparent" Foreground="{DynamicResource Ink}" BorderThickness="0" Padding="0,0,4,0" ItemContainerStyle="{StaticResource HistoryCard}">
      <ListBox.ItemTemplate><DataTemplate>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="44" Height="38" CornerRadius="4" Margin="0,0,8,0" Background="{StaticResource ImageCanvas}" VerticalAlignment="Center" ClipToBounds="True"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="Image"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Kind}" Value="Files"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="#303039" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=RowThumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image x:Name="RowThumbnail" local:HistoryThumbnail.Item="{Binding}" Stretch="UniformToFill" AutomationProperties.Name="Entry image thumbnail"/></Grid></Border>
        <StackPanel Grid.Column="1" Margin="0,0,4,0" VerticalAlignment="Center"><TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" FontSize="12" LineHeight="16"/><TextBlock Text="{Binding ListMetadata}" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource SecondaryInk}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SelectedInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
        <ToggleButton Grid.Column="2" Content="&#xE718;" Tag="{Binding Id}" IsChecked="{Binding Pinned, Mode=OneWay}" Click="OnPinRow" VerticalAlignment="Center">
         <ToggleButton.Style><Style TargetType="ToggleButton" BasedOn="{StaticResource IconToggleButton}"><Setter Property="ToolTip" Value="Pin entry"/><Setter Property="AutomationProperties.Name" Value="Pin entry"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="Unpin entry"/><Setter Property="AutomationProperties.Name" Value="Unpin entry"/></Trigger></Style.Triggers></Style></ToggleButton.Style>
        </ToggleButton>
        <Button Grid.Column="3" Content="&#xE8A7;" Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="OnPreviewRow" ToolTip="Preview and edit  Space" AutomationProperties.Name="Preview entry" VerticalAlignment="Center"/>
        <Button Grid.Column="4" Content="&#xE8C8;" Style="{StaticResource IconButton}" Tag="{Binding Id}" Click="OnCopyRow" ToolTip="Copy" AutomationProperties.Name="Copy entry" VerticalAlignment="Center"/>
       </Grid>
      </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
      <TextBlock Text="&#xE77F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="36" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
      <TextBlock x:Name="EmptyTitle" Text="Nothing copied yet" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock x:Name="EmptyDescription" Text="Copy text, images, or files to find them here." TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7" Margin="0,10"/>
      <Button x:Name="StartButton" Content="Start local history" Style="{StaticResource AccentButton}" Click="OnRecording" HorizontalAlignment="Center"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="PreviewPanel" Grid.Column="1" Margin="12,0,0,0" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><Button DockPanel.Dock="Right" Content="&#xE711;" Style="{StaticResource IconButton}" Click="OnClosePreview" AutomationProperties.Name="Close preview"/><TextBlock x:Name="PreviewTitle" Text="Preview" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></DockPanel>
     <TextBlock x:Name="PreviewMetadata" Grid.Row="1" TextWrapping="Wrap" FontSize="11" Opacity="0.65" Margin="0,8"/>
     <Grid Grid.Row="2">
      <TextBox x:Name="Editor" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnEditorChanged" FontFamily="Consolas" FontSize="13" AutomationProperties.Name="Editable clipboard text"/>
      <Border x:Name="ImagePreviewFrame" Background="{StaticResource ImageCanvas}" CornerRadius="6" ClipToBounds="True" Visibility="Collapsed"><Image x:Name="ImagePreview" Stretch="Uniform" Margin="6" AutomationProperties.Name="Clipboard image preview"/></Border>
      <TextBox x:Name="FilePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="File references"/>
      <TextBlock x:Name="PreviewPlaceholder" Text="Select an entry to preview" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap" Margin="12"/>
     </Grid>
     <WrapPanel x:Name="TextToolbar" Grid.Row="3" Margin="0,6,0,0">
      <ComboBox x:Name="TextActions" Width="138" SelectionChanged="OnTextAction" SelectedIndex="0"><ComboBoxItem Content="Text actions"/><ComboBoxItem Content="Trim whitespace"/><ComboBoxItem Content="Remove blank lines"/><ComboBoxItem Content="UPPERCASE"/><ComboBoxItem Content="lowercase"/><ComboBoxItem Content="Title Case"/></ComboBox>
      <Button x:Name="SaveButton" Content="Save" Click="OnSaveDraft" Margin="8,0,0,0" ToolTip="Save draft  Ctrl+S"/>
      <Button Content="Revert" Click="OnRevert" Margin="8,0,0,0"/>
     </WrapPanel>
     <WrapPanel Grid.Row="4" Margin="0,6,0,0"><Button Content="Copy" Click="OnCopy"/><Button Content="Paste" Click="OnPaste" Margin="6,0,0,0"/><Button x:Name="PlainPasteButton" Content="Plain text" Click="OnPastePlain" Margin="6,0,0,0"/></WrapPanel>
    </Grid>
   </Grid>
   <StackPanel Grid.Row="5" Margin="0,6,0,0">
    <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,8"/>
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="&#xE718;" Style="{StaticResource IconButton}" Click="OnPin" ToolTip="Pin/unpin selection  Ctrl+P" AutomationProperties.Name="Pin or unpin selected entries"/><Button Content="&#xE74D;" Style="{StaticResource IconButton}" Click="OnDelete" ToolTip="Delete selection" AutomationProperties.Name="Delete selected entries"/><Button x:Name="PreviousPage" Content="&#xE76B;" Style="{StaticResource IconButton}" Click="OnPreviousPage" AutomationProperties.Name="Previous page"/><Button x:Name="NextPage" Content="&#xE76C;" Style="{StaticResource IconButton}" Click="OnNextPage" AutomationProperties.Name="Next page"/></StackPanel>
     <Button Content="Clear history…" Click="OnClearHistory" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="8,6"/>
    </DockPanel>
    <TextBlock x:Name="ShortcutLabel" FontSize="10" Foreground="{DynamicResource SecondaryInk}" TextWrapping="Wrap" Margin="6,2,0,0"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
